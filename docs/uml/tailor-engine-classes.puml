  abstract class "AbstractOperator" {}
  class "Pipe"{ }
  class "GroupPipe" {}
  class "GroupSource" {}
  class "ResultsPrinterAdapter" {}
  class "CombineResults" {}
  class "PipeSeqConstraint" {}
  class "FilterAtomResultByCondition" {}
  class "FilterGroupByDescription" {}
