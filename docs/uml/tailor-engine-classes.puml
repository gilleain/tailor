@startuml tailor-engine

title tailor.engine — Class Diagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam wrapWidth 200
hide circle
hide empty members

package "tailor.api  «external»" {
  interface "Operator" as Operator {}
  interface "ResultsPrinter" as ResultsPrinter {}
  interface "AtomListDescription" as AtomListDescription
  interface "AtomListMeasure" as AtomListMeasure
  interface "SegmentListDescription" as SegmentListDescription
  interface "SegmentPropertyDescription" as SegmentPropertyDescription
  interface "GroupPropertyDescription" as GroupPropertyDescription
}

package "tailor.engine" {
  interface "Engine" {}
  class "EngineFactory" {}
  class "EngineType" {}
  class "PlanEngine"  {}
  class "Run" as Run {}
  class "SysoutResultsPrinter"  {}
  class "Script" {}
  class "ParsedScript" as ParsedScript {}
  class "LevelText" {}
  class "PropertyText"{}
  class "Selection" {}
  abstract class "MeasureText" {}
  class "GeometricMeasureText" {}
  class "PropertyMeasureText" {}
}

package "tailor.engine.logical" {
  interface "LogicalOperator" {}
  class "LogicalPlan"  {}
  class "Edge" {}
  class "LogicalPlanner" {}
  class "SelectAllChains" {}
  class "SelectAllResidues" {}
  class "SelectAtomByName" {}
  class "SelectChainByType" {}
  class "SelectGroupByType" {}
}

